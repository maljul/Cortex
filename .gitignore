# Secrets — never commit. CORTEX_DSN lives here.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Benchmark working directories. The cassettes under bench/cassettes/ ARE committed
# (06 §5: a cassette that is not in the repository is a promise, not a recording), and
# so are the published results under bench/results/ (§6). These are the per-invocation
# scratch runs: the NAIVE arm's shared JSON file and one run record per arm.
bench/runs/

# Infrastructure build output. `infra/lambda-dist/` is the esbuild bundle, rebuilt by
# `node infra/bundle.mjs` on every deploy; `cdk.out/` is CDK's synthesized template.
# Neither is committed, and cdk.out in particular must not be: until V22 it carried the
# reader DSN inline, which is the finding that moved the value into Secrets Manager.
infra/lambda-dist/
infra/cdk/cdk.out/
.aws-sam/

# OS / editor
.DS_Store
.env

# Claude Code — local, per-machine permissions
.claude/settings.local.json
