{
  // `bench/fixtures` is the benchmark's subject, not this project's source: a small
  // service that agents are asked to modify. It is deliberately imperfect — that is
  // what gives the tasks something to do — and typechecking it here would couple our
  // build to fixture content and make the corpus answer to our tsconfig rather than
  // look like an ordinary repository. Nothing imports it; `bench/` itself is checked.
  //
  // `infra/cdk` is a CDK app with its own `tsconfig.json`, its own
  // `node_modules`, and CommonJS module resolution. It is a separate deployable that
  // happens to live in this tree, not part of this project's compilation, and pulling
  // it in here would make `npx tsc --noEmit` — the thing someone cloning the repo runs
  // first (B1) — answer to CDK's generated scaffolding. `infra/lambda/` is deliberately
  // NOT excluded: the handler imports `src/db/identity.ts` and must be typechecked
  // against it, which is the whole point of reusing that function rather than
  // reimplementing the query in a Lambda.
  "exclude": ["bench/fixtures", "infra/cdk", "infra/lambda-dist"],
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
