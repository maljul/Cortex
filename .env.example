# Copy to .env and fill in. .env is gitignored — never commit it.
# Config contract: spec/05-INTERFACES.md section 6.

# Write-plane connection string (CockroachDB Cloud). Server side only.
LEASEHOLD_DSN=postgresql://user:password@host:26257/leasehold?sslmode=verify-full

LEASEHOLD_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
LEASEHOLD_REPO=
LEASEHOLD_LEASE_TTL=10m
LEASEHOLD_DEDUPE_THRESHOLD=0.28

BEDROCK_REGION=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_REASON_MODEL=
